# --- Base de données ---
DATABASE_URL=postgresql://forlife:forlife@localhost:5432/forlife_com

# --- Sécurité (générer des valeurs aléatoires en production : openssl rand -base64 48) ---
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Clé AES-256-GCM (32 octets en base64) pour chiffrer les secrets (tokens sociaux, etc.)
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# --- Serveur ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Exécuter le worker de jobs dans le process API (pratique en dev ; false en production)
RUN_WORKER_INLINE=true

# --- Stockage objets (local en dev ; S3 prévu) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# --- IA : fournisseurs activés par ordre de préférence (feature flag). "mock" fonctionne sans clé. ---
AI_PROVIDERS=anthropic,mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Plateforme ---
APP_URL=http://localhost:5173
# Emails promus administrateurs de la plateforme (back-office) à la connexion
PLATFORM_ADMIN_EMAILS=
# Emails : "log" (développement) ou "resend" (production, nécessite RESEND_API_KEY)
EMAIL_DRIVER=log
EMAIL_FROM=Forlife Com <no-reply@forlifecom.ci>
RESEND_API_KEY=

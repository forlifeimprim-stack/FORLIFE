# --- Base de données ---
DATABASE_URL=postgresql://forlife:forlife@localhost:5432/forlife_com

# --- Sécurité (générer des valeurs aléatoires en production : openssl rand -base64 48) ---
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Clé AES-256-GCM (32 octets en base64) pour chiffrer les secrets (tokens sociaux, etc.)
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# --- Serveur ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Exécuter le worker de jobs dans le process API (pratique en dev ; false en production)
RUN_WORKER_INLINE=true

# --- Stockage objets : "local" (dev) ou "gcs" (production, nécessite GCS_BUCKET) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
GCS_BUCKET=

# --- IA : fournisseurs activés par ordre de préférence (feature flag). "mock" fonctionne sans clé. ---
AI_PROVIDERS=anthropic,mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Plateforme ---
APP_URL=http://localhost:5173
# Emails promus administrateurs de la plateforme (back-office) à la connexion
PLATFORM_ADMIN_EMAILS=
# Emails : "log" (développement) ou "resend" (production, nécessite RESEND_API_KEY)
EMAIL_DRIVER=log
EMAIL_FROM=Forlife Com <no-reply@forlifecom.ci>
RESEND_API_KEY=

# --- Social Hub ---
# URL publique de l'API (callbacks OAuth). En dev, l'URL du front (proxy /api).
API_PUBLIC_URL=http://localhost:4000
# Application Meta (Facebook/Instagram) : https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Compte de démonstration (publication simulée)
SOCIAL_SANDBOX_ENABLED=true

# --- Video Studio ---
FFMPEG_PATH=ffmpeg

# --- Paiements (CinetPay : Orange Money, MTN MoMo, Moov, Wave, carte) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Guichet de démonstration (aucun argent réel). Désactivé par défaut en production.
PAYMENT_SANDBOX_ENABLED=true

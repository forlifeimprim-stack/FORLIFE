# Configuration NON SECRÈTE de la production (le dépôt est public : aucun mot de passe, aucune clé ici).
# Les secrets vivent dans Google Secret Manager et sont injectés par Cloud Run.
# Tant que GCP_PROJECT_ID est vide, le workflow de déploiement ne fait rien.

# Projet Firebase / Google Cloud « AI Growth et Creative OS »
GCP_PROJECT_ID=ai-growth-et-creative-os
GCP_PROJECT_NUMBER=126376919374
REGION=europe-west1
# Instance Cloud SQL (format projet:région:instance)
CLOUDSQL_INSTANCE=ai-growth-et-creative-os:europe-west1:forlife-db
GCS_BUCKET=ai-growth-et-creative-os-files
# Site Firebase Hosting de l'application (par défaut : l'ID du projet → https://<ID>.web.app)
FIREBASE_SITE=ai-growth-et-creative-os

# Fournisseurs IA : « mock » tant que la clé Anthropic n'est pas dans Secret Manager, puis « anthropic,mock »
AI_PROVIDERS=anthropic
# Emails : « log » tant que la clé Resend n'est pas ajoutée, puis « resend »
EMAIL_DRIVER=log
EMAIL_FROM="Forlife Com <no-reply@forlifecom.ci>"
# Guichet de paiement de démonstration (aucun argent réel) : toujours false en production réelle
PAYMENT_SANDBOX_ENABLED=false
SOCIAL_SANDBOX_ENABLED=true

# Secrets facultatifs à brancher quand ils existent dans Secret Manager (VARIABLE=nom-du-secret, séparés par des virgules)
# ex. ANTHROPIC_API_KEY=forlife-anthropic-key,CINETPAY_API_KEY=forlife-cinetpay-key,META_APP_SECRET=forlife-meta-secret,RESEND_API_KEY=forlife-resend-key
OPTIONAL_SECRETS=ANTHROPIC_API_KEY=forlife-anthropic-key,META_APP_SECRET=forlife-meta-secret,LINKEDIN_CLIENT_SECRET=forlife-linkedin-secret
# Variables facultatives non secrètes (séparées par « | »), ex. CINETPAY_SITE_ID=123456|META_APP_ID=1234567890
EXTRA_ENV=META_APP_ID=4020918508203295|LINKEDIN_CLIENT_ID=78le7bt8miifhs

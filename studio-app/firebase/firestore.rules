rules_version = '2';
// ForLife Studio : la base n'est JAMAIS lue directement par les clients.
// - La Station écrit avec un compte de service (Admin SDK, hors règles).
// - Les clients passent par les Cloud Functions (selfie -> galerie), qui
//   vérifient le jeton de galerie et renvoient des URL signées.
// - Le personnel (rôle porté par un custom claim, double authentification) lit tout.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'photographe']
        && request.auth.token.firebase.sign_in_second_factor != null;
    }
    match /{document=**} {
      allow read: if isStaff();
      allow write: if false;
    }
  }
}

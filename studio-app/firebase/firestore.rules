rules_version = '2';
// ForLife Studio : seuls les comptes du personnel (rôle attribué par scripts/set-staff.js)
// lisent et écrivent. Les clients passent exclusivement par les Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null && request.auth.token.role in ['admin', 'photographe'];
    }
    match /studios/{studio}/days/{day}/photos/{photo} {
      allow read, write: if isStaff();
    }
    match /studios/{studio}/days/{day} {
      allow read, write: if isStaff();
    }
    // Galeries clients et limites de débit : Cloud Functions uniquement.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

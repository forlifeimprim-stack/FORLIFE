rules_version = '2';
// Photos privées : le personnel écrit et lit ; les clients reçoivent des URL signées.
service firebase.storage {
  match /b/{bucket}/o {
    match /studios/{studio}/{day}/{kind}/{file} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'photographe'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'photographe']
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
